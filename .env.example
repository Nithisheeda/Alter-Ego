
# Server-side only — read by the Vercel Edge Function at api/claude.ts.
# Never prefix this with VITE_ (that would bundle it into the client build).
# Set it in your Vercel project's Environment Variables for the deployed
# app, or in a local .env when running `vercel dev`.
#
# Without it, /api/claude returns a 500 and the app falls back to mock
# diagnostics — unless a user has saved their own key in Settings, which
# always takes priority and calls Anthropic directly from the browser.
ANTHROPIC_API_KEY=
